# No local .env needed — keys are loaded from demo/.env automatically.
#
# Required keys in demo/.env:
#   OPENAI_API_KEY=sk-...
#   OPENAI_DEBUG=false
#   LUMOZ_API_KEY=client_id:client_secret
#   OTEL_ENDPOINT=https://api.lumoz.ai/proxy/v1/traces
#   LUMOZ_LOG_LEVEL=error
#   LUMOZ_PRINT_OTEL_HEADERS=false
