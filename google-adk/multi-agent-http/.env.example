# LLM configuration. This example defaults to OpenAI through LiteLLM.
OPENAI_API_KEY=your_openai_api_key
LITELLM_MODEL=openai/gpt-5.4-mini

# Lumoz/OpenTelemetry export.
LUMOZ_API_KEY=your_client_id:your_client_secret
OTEL_ENDPOINT=https://api.lumoz.ai/v1/traces
DEPLOYMENT_ENVIRONMENT=development

# Service URLs.
REMOTE_CITY_EXPERT_URL=http://localhost:8001/recommend
ORCHESTRATOR_URL=http://localhost:8000/chat
